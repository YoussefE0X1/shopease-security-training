{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:backend": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:frontend": "npm --prefix client run dev",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"npm run dev\" \"npm run dev:frontend\"",
    "install:all": "npm install && npm --prefix client install",
    "env": "node -e \"require('fs').copyFileSync('.env.example', '.env')\"",
    "setup": "npm run install:all && npm run env && npm run seed:all",
    "seed:challenges": "ts-node src/seed/challenges.seed.ts",
    "seed:data": "ts-node src/seed/data.seed.ts",
    "seed:reset": "ts-node src/seed/reset.seed.ts",
    "seed:all": "npm run seed:data && npm run seed:challenges"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^9.7.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "slugify": "^1.6.9",
    "uuid": "^14.0.1"
  }
}
